[Unit]
Description=F# Finance Anomaly Detector (isolated)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=financeapp
Group=financeapp
WorkingDirectory=/home/micu/f_sharp/publish
Environment=DOTNET_CLI_HOME=/var/lib/finance-anomaly-detector
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/finance-anomaly-detector/app.env
ExecStart=/usr/bin/dotnet /home/micu/f_sharp/publish/FinanceAnomalyDetector.dll
Restart=always
RestartSec=10
TimeoutStopSec=30
SyslogIdentifier=finance-anomaly-detector
UMask=0077

StateDirectory=finance-anomaly-detector
StateDirectoryMode=0700
BindReadOnlyPaths=/home/micu/f_sharp/publish
BindReadOnlyPaths=/home/micu/f_sharp/public

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
TasksMax=64
MemoryHigh=128M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
