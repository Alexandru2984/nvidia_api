[Unit]
Description=Ruby Bookmarks (isolated)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bookmarksapp
Group=bookmarksapp
WorkingDirectory=/home/micu/ruby_on_rails
Environment=HOME=/var/lib/bookmarks
Environment=RAILS_ENV=production
EnvironmentFile=/etc/bookmarks/bookmarks.env
ExecStart=/home/micu/ruby_on_rails/bin/rails server -e production -b 127.0.0.1
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=60
UMask=0077

StateDirectory=bookmarks
StateDirectoryMode=0700
RuntimeDirectory=bookmarks
RuntimeDirectoryMode=0700
BindReadOnlyPaths=/home/micu/ruby_on_rails
BindPaths=/var/lib/bookmarks/storage:/home/micu/ruby_on_rails/storage
BindPaths=/run/bookmarks:/home/micu/ruby_on_rails/tmp
BindReadOnlyPaths=/etc/bookmarks/master.key:/home/micu/ruby_on_rails/config/master.key

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=4096
TasksMax=96
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
