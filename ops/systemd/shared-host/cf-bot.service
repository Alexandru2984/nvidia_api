[Unit]
Description=Cloudflare analytics Telegram bot (isolated)
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/opt/cf-bot/current/venv/bin/python
ConditionPathExists=/opt/cf-bot/current/cf_analytics_bot.py
ConditionPathExists=/etc/cf-bot/credentials.json

[Service]
Type=simple
User=cfbot
Group=cfbot
SupplementaryGroups=adm
WorkingDirectory=/opt/cf-bot/current
Environment=HOME=/var/lib/cf-bot
Environment=MPLCONFIGDIR=/var/cache/cf-bot/matplotlib
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CF_BOT_CREDENTIALS=/etc/cf-bot/credentials.json
Environment=CF_BOT_RUNTIME_DIR=/run/cf-bot
Environment=CF_BOT_NGINX_ERROR_LOG=/run/cf-bot/nginx-error.log
ExecStart=/opt/cf-bot/current/venv/bin/python /opt/cf-bot/current/cf_analytics_bot.py
Restart=always
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
UMask=0077

StateDirectory=cf-bot
StateDirectoryMode=0700
CacheDirectory=cf-bot
CacheDirectoryMode=0700
RuntimeDirectory=cf-bot
RuntimeDirectoryMode=0700
InaccessiblePaths=/var/log
BindReadOnlyPaths=/var/log/nginx/error.log:/run/cf-bot/nginx-error.log

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=1024
TasksMax=64
CPUQuota=50%
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
