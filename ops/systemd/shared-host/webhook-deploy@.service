[Unit]
Description=Allowlisted deployment for webhook target %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=micu
Group=micu
WorkingDirectory=/home/micu
ExecStart=/usr/local/libexec/webhook-cicd-deploy %i
TimeoutStartSec=20min
UMask=0022

PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/micu/apps/cicd/logs
BindPaths=/home/micu/brainfuck
BindPaths=/home/micu/cobol
BindPaths=/home/micu/code-forest
BindPaths=/home/micu/crystal
BindPaths=/home/micu/deaddrop
BindPaths=/home/micu/drogon_blog
BindPaths=/home/micu/lisp
BindPaths=/home/micu/lua
BindPaths=/home/micu/nvidia
BindPaths=/home/micu/pastebox
BindPaths=/home/micu/taskmanager
BindPaths=/home/micu/ruby_on_rails
BindPaths=/home/micu/pdf_Editor_v2
BindPaths=/home/micu/PCEP_webApp
BindPaths=/home/micu/expenseTracker_cs
BindPaths=/home/micu/pixel-art-multiplayer
BindPaths=/home/micu/Micu_market
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitCORE=0
TasksMax=256
MemoryMax=2G
