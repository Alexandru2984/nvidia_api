[Unit]
Description=Umami Analytics (isolated)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=umami
Group=umami
WorkingDirectory=/home/micu/umami
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
EnvironmentFile=/etc/umami/umami.env
ExecStart=/usr/bin/node /home/micu/umami/.next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/micu/umami
BindReadOnlyPaths=/etc/umami/empty.env:/home/micu/umami/.env
BindReadOnlyPaths=/etc/umami/empty.env:/home/micu/umami/.next/standalone/.env
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
TasksMax=64
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
