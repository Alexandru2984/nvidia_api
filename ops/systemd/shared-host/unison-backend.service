[Unit]
Description=Unison Idea Evolution backend (isolated)
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/home/micu/unisonTrying/backend/.venv/bin/uvicorn
ConditionFileIsExecutable=/home/micu/unisonTrying/ucm-bin/ucm-bin
ConditionPathExists=/home/micu/unisonTrying/unison/evolution.uc

[Service]
Type=simple
User=unisonapp
Group=unisonapp
WorkingDirectory=/home/micu/unisonTrying/backend
Environment=HOME=/var/lib/unison-backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DB_PATH=/var/lib/unison-backend/evolution.db
Environment=UNISON_BIN=/home/micu/unisonTrying/ucm-bin/ucm-bin
Environment=UNISON_PROGRAM=/home/micu/unisonTrying/unison/evolution.uc
Environment=PUBLIC_ORIGIN=https://unison.micutu.com
Environment=ENABLE_API_DOCS=false
Environment=MAX_IDEAS=10000
Environment=MAX_RESULTS=500
Environment=MUTATION_TIMEOUT_SECONDS=5
ExecStart=/home/micu/unisonTrying/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8097 --workers 1 --ws-max-size 1024 --timeout-keep-alive 5 --limit-concurrency 32 --backlog 64 --no-access-log
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077

StateDirectory=unison-backend
StateDirectoryMode=0700
RuntimeDirectory=unison-backend
RuntimeDirectoryMode=0700
BindReadOnlyPaths=/home/micu/unisonTrying

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=4096
TasksMax=64
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
