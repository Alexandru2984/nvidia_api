[Unit]
Description=PasteBox (isolated)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pastebox
Group=pastebox
WorkingDirectory=/var/lib/pastebox/runtime
ExecStart=/home/micu/pastebox/backend/build/backend
Restart=always
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077

StateDirectory=pastebox
StateDirectoryMode=0700
BindReadOnlyPaths=/home/micu/pastebox/backend/build
BindReadOnlyPaths=/etc/pastebox/config.json:/var/lib/pastebox/config.json
BindReadOnlyPaths=/home/micu/pastebox/backend/build/public:/var/lib/pastebox/runtime/public

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
TasksMax=32
MemoryHigh=64M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
