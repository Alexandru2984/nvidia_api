[Unit]
Description=Crystal Traffic Analyzer (isolated)
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=simple
User=crystaltraffic
Group=crystaltraffic
SupplementaryGroups=adm
WorkingDirectory=/home/micu/crystal/traffic-analyzer
EnvironmentFile=/etc/traffic-analyzer/app.env
ExecStart=/home/micu/crystal/traffic-analyzer/bin/analyzer
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

StateDirectory=traffic-analyzer
StateDirectoryMode=0700
BindReadOnlyPaths=/home/micu/crystal/traffic-analyzer
BindPaths=/var/lib/traffic-analyzer/logs:/home/micu/crystal/traffic-analyzer/logs
TemporaryFileSystem=/var/log:ro
BindReadOnlyPaths=/var/log/nginx

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
TasksMax=32
MemoryHigh=64M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
