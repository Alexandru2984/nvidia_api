[Unit]
Description=AI Chat Hub local attachment malware scanner
Documentation=https://docs.clamav.net/
After=local-fs.target clamav-freshclam.service
ConditionPathExistsGlob=/var/lib/clamav/main.c[vl]d
ConditionPathExistsGlob=/var/lib/clamav/daily.c[vl]d

[Service]
Type=simple
User=clamav
Group=clamav
ExecStart=/usr/sbin/clamd --foreground=true --config-file=/etc/clamav/clamd.conf
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
RuntimeDirectory=clamav
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/clamav
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
RemoveIPC=yes
MemoryMax=2G
TasksMax=64

[Install]
WantedBy=multi-user.target
