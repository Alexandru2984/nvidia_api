[Unit]
Description=AI Chat Hub isolated untrusted-document parser
After=local-fs.target
ConditionPathExists=/usr/local/libexec/aichat-document-parser
ConditionPathExists=/usr/local/libexec/aichat-document-worker
ConditionPathExists=/opt/aichat-python-current/bin/python

[Service]
Type=simple
User=aichat-parser
Group=aichat-parser
ExecStart=/usr/bin/python3 -I /usr/local/libexec/aichat-document-parser
Restart=always
RestartSec=5
TimeoutStopSec=10
RuntimeDirectory=aichat-document-parser
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
RemoveIPC=yes
MemoryHigh=640M
MemoryMax=768M
CPUQuota=100%
TasksMax=8
LimitCORE=0

[Install]
WantedBy=multi-user.target
