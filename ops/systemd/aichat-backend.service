[Unit]
Description=AI Chat Hub backend
Wants=network-online.target aichat-document-parser.service
After=network-online.target postgresql.service aichat-document-parser.service

[Service]
Type=simple
User=aichat
Group=aichat-origin
SupplementaryGroups=aichat clamav aichat-parser
WorkingDirectory=/opt/aichat-backend-current
RuntimeDirectory=aichat-backend
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AICHAT_RUNTIME_DIR=/home/micu/nvidia/backend
# Keep operational request shape and latency without retaining client IP,
# User-Agent, Referer, cookies or query strings. Literal percent signs must be
# doubled for systemd and reach Gunicorn as single format markers.
ExecStart=/opt/aichat-python-current/bin/python -m gunicorn nvidia_chat.wsgi:application --bind unix:/run/aichat-backend/gunicorn.sock --forwarded-allow-ips=* --worker-class gthread --workers 3 --threads 8 --timeout 600 --graceful-timeout 30 --access-logfile - --access-logformat '%%(t)s "%%(m)s %%(U)s %%(H)s" %%(s)s %%(b)s %%(L)s' --error-logfile -
ExecStartPost=/opt/aichat-python-current/bin/python -m chat.prepare_origin_socket
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
