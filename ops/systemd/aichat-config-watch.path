[Unit]
Description=Watch AI Chat Hub protected configuration for changes

[Path]
PathChanged=/home/micu/nvidia/backend/.env
PathChanged=/home/micu/scripts/.env
PathChanged=/etc/nginx/sites-available/aichat.micutu.com
PathChanged=/etc/systemd/system/aichat-backend.service
PathChanged=/etc/systemd/system/aichat-backend.service.d/hardening.conf
PathChanged=/etc/systemd/system/aichat-maintenance.service
PathChanged=/etc/systemd/system/aichat-model-probe.service
PathChanged=/etc/systemd/system/aichat-model-probe.timer
PathChanged=/etc/systemd/system/aichat-restore-drill.service
PathChanged=/etc/systemd/system/aichat-restore-drill.timer
PathChanged=/etc/systemd/system/aichat-security-monitor.service
PathChanged=/etc/systemd/system/aichat-config-watch.service
PathChanged=/etc/systemd/system/aichat-config-watch.path
PathChanged=/etc/sysusers.d/aichat-monitor.conf
PathChanged=/etc/sysusers.d/aichat-model-probe.conf
PathChanged=/etc/aichat/model-probe-api-key
PathChanged=/etc/aichat/model-status-private.pem
PathChanged=/etc/aichat/model-status-public.pem
PathChanged=/usr/local/libexec/aichat-security-monitor
PathChanged=/usr/local/libexec/aichat-restore-drill
Unit=aichat-config-watch.service

[Install]
WantedBy=multi-user.target
