[Unit]
Description=AI Chat Hub isolated PostgreSQL restore verification
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=micu
Group=micu
WorkingDirectory=/opt/aichat-backend-current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AICHAT_RUNTIME_DIR=/home/micu/nvidia/backend
Environment=AICHAT_APP_DIR=/opt/aichat-backend-current
Environment=AICHAT_PYTHON=/opt/aichat-python-current/bin/python
ExecStart=/usr/local/libexec/aichat-restore-drill
StandardOutput=append:/home/micu/backups/nvidia_db/restore-drill.log
StandardError=journal
UMask=0077
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/micu/nvidia/backend/.env
BindPaths=/home/micu/backups/nvidia_db
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=512M
TasksMax=32
TimeoutStartSec=20m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
