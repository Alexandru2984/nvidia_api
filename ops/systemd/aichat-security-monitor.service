[Unit]
Description=AI Chat Hub security and recovery monitor
After=network-online.target aichat-backend.service aichat-clamd.service aichat-document-parser.service

[Service]
Type=oneshot
User=aichat-monitor
Group=aichat-monitor
# Grant journal and local socket visibility only inside this dedicated,
# non-login monitor process.
SupplementaryGroups=systemd-journal clamav aichat-parser aichat-origin
LoadCredential=telegram.env:/home/micu/scripts/.env
ExecStart=/usr/local/libexec/aichat-security-monitor --credentials=%d/telegram.env
UMask=0077
StateDirectory=aichat-security-monitor
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/micu/backups/nvidia_db
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=32
