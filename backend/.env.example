# Copy to backend/.env and fill in. Django loads it via python-dotenv.

DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Independent, versioned 2FA root keys. Generate each value with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Keep retired keys until `manage.py audit_two_factor_keys --require-active`
# confirms that no stored secret or recovery code still references them.
# TWO_FACTOR_KEYS={"2026-10":"replace-with-a-generated-base64url-key"}
# TWO_FACTOR_ACTIVE_KEY_ID=2026-10
TWO_FACTOR_LEGACY_SECRET_KEY_ENABLED=True
# Separate keyring for pseudonymous admin object references and integrity tags.
# ADMIN_AUDIT_KEYS={"2026-10":"replace-with-another-generated-base64url-key"}
# ADMIN_AUDIT_ACTIVE_KEY_ID=2026-10
ADMIN_AUDIT_LEGACY_SECRET_KEY_ENABLED=True

# PostgreSQL (per-app DB; use sqlite via test_settings only for tests)
DB_NAME=nvidia_db
DB_USER=nvidia_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# NVIDIA NIM API — get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
# These URLs are fail-closed to the exact approved NVIDIA HTTPS hosts/paths.
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
MODEL_STATUS_REQUIRED=False
MODEL_STATUS_MAX_AGE_SECONDS=691200
CHAT_GENERATION_LEASE_SECONDS=900
GENERATION_REQUEST_RETENTION_DAYS=7
CHAT_MAX_CONVERSATIONS_PER_USER=500
CHAT_MAX_MESSAGES_PER_USER=10000
CHAT_MAX_MESSAGES_PER_CONVERSATION=2000
CHAT_MAX_ASSISTANT_CHARS=64000
CHAT_MAX_EXPORT_BYTES=26214400
SESSION_ABSOLUTE_MAX_AGE_SECONDS=2592000
SESSION_MAX_ACTIVE_PER_USER=20
RECENT_AUTH_MAX_AGE_SECONDS=300
AI_GENERATION_ENABLED=True
AI_USER_DAILY_CHAT_LIMIT=100
AI_USER_DAILY_IMAGE_LIMIT=10
AI_GLOBAL_DAILY_CHAT_LIMIT=500
AI_GLOBAL_DAILY_IMAGE_LIMIT=50
AI_USER_DAILY_TOKEN_LIMIT=500000
AI_GLOBAL_DAILY_TOKEN_LIMIT=2500000
AI_CHAT_TOKEN_RESERVATION=32768
NVIDIA_GENAI_BASE=https://ai.api.nvidia.com/v1/genai
NVIDIA_GENAI_STATUS_BASE=https://ai.api.nvidia.com/v1/status

# SMTP for OTP / password-reset emails.
# Port 465 → implicit TLS (SMTPS); anything else → STARTTLS.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com

# Absolute URL of the deployed frontend (used in emails).
FRONTEND_URL=http://localhost:5173

# Registration: open, invite, or closed. Production defaults should be explicit.
REGISTRATION_MODE=open
REGISTRATION_INVITE_AUDIT_DAYS=90
ADMIN_AUDIT_RETENTION_DAYS=365
ATTACHMENT_UPLOAD_ATTEMPT_TTL_HOURS=24
# Production defaults to required; DEBUG environments default to disabled.
# ATTACHMENT_MALWARE_SCAN_REQUIRED=False
ATTACHMENT_SCANNER_SOCKET=/run/clamav/clamd.ctl
ATTACHMENT_SCAN_TIMEOUT_SECONDS=20
# Production defaults to required; DEBUG environments default to disabled.
# DOCUMENT_PARSER_REQUIRED=False
DOCUMENT_PARSER_SOCKET=/run/aichat-document-parser/parser.sock
DOCUMENT_PARSER_TIMEOUT_SECONDS=10
