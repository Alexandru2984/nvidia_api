# Copy to backend/.env and fill in. Django loads it via python-dotenv.

DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (per-app DB; use sqlite via test_settings only for tests)
DB_NAME=nvidia_db
DB_USER=nvidia_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# NVIDIA NIM API — get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_GENERATION_ENABLED=True
AI_USER_DAILY_CHAT_LIMIT=100
AI_USER_DAILY_IMAGE_LIMIT=10
AI_GLOBAL_DAILY_CHAT_LIMIT=500
AI_GLOBAL_DAILY_IMAGE_LIMIT=50
AI_USER_DAILY_TOKEN_LIMIT=500000
AI_GLOBAL_DAILY_TOKEN_LIMIT=2500000
AI_CHAT_TOKEN_RESERVATION=32768
NVIDIA_GENAI_BASE=https://ai.api.nvidia.com/v1/genai
NVIDIA_GENAI_STATUS_BASE=https://ai.api.nvidia.com/v1/status

# SMTP for OTP / password-reset emails.
# Port 465 → implicit TLS (SMTPS); anything else → STARTTLS.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com

# Absolute URL of the deployed frontend (used in emails).
FRONTEND_URL=http://localhost:5173
